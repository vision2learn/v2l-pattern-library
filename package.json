{
  "name": "vision2learn-pattern-library",
  "version": "2.0.0",
  "description": "Frontend Styleguide and Pattern Library for Vision2Learn",
  "repository": "https://github.com/MrSleeth/v2l-pattern-library/",
  "main": "index.js",
  "scripts": {
    "start-proto": "docker run -d --rm --cpus='.75' --name 'v2l-prototype' -v $(pwd):/code:cached -p 8080:8080 -p 3001:3001  mrsleeth/v2l:node10 start",
    "stop-proto": "docker stop v2l-prototype",
    "start": "yarn install && yarn run dev",
    "dev": "netlify-cms-proxy-server & ELEVENTY_ENV=dev gulp dev & ELEVENTY_ENV=dev eleventy --serve",
    "debug": "ELEVENTY_ENV=dev gulp dev & ELEVENTY_ENV=dev DEBUG=Eleventy* eleventy --serve",
    "build": "ELEVENTY_ENV=dev gulp build && ELEVENTY_ENV=dev yarn eleventy",
    "staging": "ELEVENTY_ENV=staging gulp build && ELEVENTY_ENV=staging yarn eleventy",
    "dotnet": "ELEVENTY_ENV=dotnet gulp build & ELEVENTY_ENV=dotnet eleventy",
    "cshtml": "ELEVENTY_ENV=dotnet eleventy",
    "netlify": "ELEVENTY_ENV=netlify gulp dev & ELEVENTY_ENV=netlify eleventy --serve",
    "bs-approve": "backstop approve",
    "bs-reference": "backstop reference",
    "bs-test": "backstop test",
    "bs-init": "backstop init"
  },
  "keywords": [
    "11ty",
    "eleventy",
    "node",
    "docker"
  ],
  "author": "Daniel Sleeth",
  "license": "ISC",
  "dependencies": {
    "@11ty/eleventy": "^0.11",
    "@11ty/eleventy-img": "^0.8.0",
    "@11ty/eleventy-plugin-syntaxhighlight": "^2.0.1",
    "@paulobontempo/hsl-to-hex": "^1.0.3",
    "axios": "^0.21.1",
    "backstopjs": "^5.3.7",
    "concurrent-transform": "^1.0.0",
    "dotenv": "^6.2.0",
    "gulp": "^4.0.0",
    "gulp-concat": "^2.6.1",
    "gulp-image-resize": "^0.13.0",
    "gulp-rename": "^1.4.0",
    "gulp-sass": "^3.1.0",
    "gulp-smushit": "^1.2.0",
    "gulp-uglify": "^3.0.0",
    "html-minifier": "^3.5.21",
    "json-to-pretty-yaml": "^1.2.2",
    "luxon": "^1.11.1",
    "netlify-lambda": "^1.3.1",
    "node-fetch": "^3.1.1",
    "require-dir": "^1.0.0",
    "ssri": "^8.0.1",
    "terser": "^4.6.13",
    "xml2js": "^0.4.19"
  },
  "resolutions": {
    "terser": "3.14.*"
  },
  "devDependencies": {
    "@11ty/eleventy-navigation": "^0.1.6",
    "cypress": "^7.5.0",
    "gulp-autoprefixer": "^6.0.0",
    "gulp-babel": "^8.0.0",
    "js-yaml": "^3.14.1",
    "svgo": "^1.1.1"
  }
}
