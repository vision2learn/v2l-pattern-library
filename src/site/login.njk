<style>
  html,
  body,
  .l-wrapper {
    height: 100%;
  }

  .l-wrapper {
    display: flex;
    flex-direction: column;
  }

  main {
    flex: 1;
    align-content: start;
  }

  img {
    display: block;
    margin-top: 1.5rem;
    max-width: 70%;
    margin-left: auto;
    margin-right: auto;
  }

</style>
<script type="text/javascript" src="https://identity.netlify.com/v1/netlify-identity-widget.js"></script>
<section>
  <h2>Please log in to view the course preview</h2>
  
  <div data-netlify-identity-button></div>

  <h3>Courses for preview</h3>
  <ul>
  {% for course, unit in courses %}
    {% if course === 'understanding-autism' %}
    <li><a href="/courses/{{ course }}/1/1/1">{{ course | replace('-', ' ') | formattitle }}</a></li>
    {% endif %}
  {% endfor %}
  </ul>
  <h3>Submitting Feedback</h3>

  <p>Please use the Feedback button (displayed at the top of all pages) to log issues:</p>

  <div class="feedback-container">
    <img src="/images/feedback1.png" alt="The feedback button is in the top right of each page">

    <p>This will open the feedback form in an overlay window. Please enter as much information as you can and attach screenshots if applicable.</p>

    <p>The feedback form automatically logs information on the page you're currently on and the web browser/operating system you're using so there is no need to enter this information.</p>
    <img src="/images/feedback2.png" alt="">
  </div>

