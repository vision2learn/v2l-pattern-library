---
layout: layouts/default.liquid
test: lean management 2
---

{%- assign ids = "lm-2-u1-s1, lm-2-u1-s2" | split: ', '-%}

{%- for id in ids -%}
  {%- include logic/pagination, mod: id -%}
  <h2>{{ id }}</h2>
  <ul>
    {%- for item in collections[id] -%}
      <li>
        <a href="/courses/{{ page-urls[forloop.index0] }}">{{ item.data.title }}</a>
      </li>
    {%- endfor -%}
  </ul>  
{%- endfor -%}