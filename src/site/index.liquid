---
layout: layouts/longform.liquid
---
<style>
body {
  color: darkgrey;
}
</style>
{%- comment %} 
<h2>Components.</h2>
<ul>
  {%- for item in collections.docs %}
    <li>
      <a href="{{ item.url }}" {%- if item.data.core %}data-v2l-patterngroup="core"{%- endif %}>{{ item.fileSlug | capitalize | replace: '-', ' '}}</a>
    </li>
  {%- endfor %}
</ul> {%- endcomment %}

{%- assign ids = "it-l1-u1-s1", "it-l1-u1-s2"  | split: ', '%}

{%- for id in ids %}
  {%- include 'logic-pagination', mod: id %}
  <h2>{{ id }}</h2>
  <ol>
    {%- for item in collections[id] %}
      <li>
        <a href="/courses/{{ page-urls[forloop.index0] }}">{{ item.data.title }}</a>
      </li>
    {%- endfor %}
  </ol>  

{%- endfor %}

<p>
  <small>Site updated: {{ "now" | date: "%A, %d %B %Y %H:%M" }}</small>
</p>