---
layout: longform.liquid
permalink: "/playground/index.html"
---
<style>
body {
  color: darkgrey;
}

summary > h2,
summary > h3 {
  display: inline-block;
}

</style>

<h1>Playground</h1>

{% for course, units in courses %}
  <h2>{{ course | capitalize }}</h2>
  <ul>
    {% for unit, sessions in units | dictsort %}
      <li>
        <details>
          <summary>
            <h3>{{ unit | replace('-', ' ') | capitalize }}</h3>
          </summary>
          <ul>
            {% for session, pages in sessions | dictsort %}
              <li>
                {{ session | replace('-', ' ') | capitalize }}
                <ul>
                  {% for page,data in pages | dictsort %}
                    <li>
                      Page {{ page }}: 
                      {{ data.title }}
                    </li>
                  {% endfor %}
                </ul>
              </li>
            {% endfor %}
          </ul>
        </details>
      </li>
    {% endfor %}
  </ul>
{% endfor %}
