{%- assign sentences = components.word-quiz.sentences -%}

{%- assign answers = "" -%}
{%- for item in sentences -%}
  {%- assign answers = answers | append: item.answer -%}

  {%- unless forloop.last -%}
    {%- assign answers = answers | append: ", " -%}
  {%- else -%}
    {%- assign answers = answers | split: ", " -%}
  {%- endunless -%}
{%- endfor -%}

{% comment %} Build dropdown {% endcomment %}

<section>
  <h2>Word Bank Quiz</h2>

  <p>Make sure you have read the <b>Read All About It</b> accompanying information before attempting this quiz.</p>

  <p>Add the correct words from the word bank and into the following sentences:</p>

  <h3>Word Bank</h3>
    <ul>
      {%- for answer in answers -%}
        <li>{{ answer | capitalize }}</li>
      {%- endfor -%}
    </ul>

  <form class="c-wordbank">
    <ol class="c-wordbank__questions">
      {%- for item in sentences -%}
        {%- assign id = forloop.index | prepend: 'q' -%}
        {%- assign sentence = item.sentence | replace: item.answer, "REPLACE" -%}
        {%- assign sentence = sentence | split: ' ' -%}
        <li>
          <label class="visually-hidden" for="{{ id }}">Select the correct word for question {{ forloop.index }}</label>
          {%- for word in sentence -%}
            {%- unless word == "REPLACE" -%}
              {{ word | append: ' '}}  
            {%- else -%}
              <select id="{{ id }}" name="{{ id }}" class="c-wordbank__options">
                <option value="">Select an answer</option>
                {% comment %} TODO: Abstract into logic file? {% endcomment %}
                {%- assign options = "" -%}
                {%- for answer in answers -%}
                  {%- if answer == item.answer -%}
                    {%- assign val = "value='true'" -%}
                  {%- else -%}
                    {%- assign val = "value='false'" -%}
                  {%- endif -%}

                  {%- assign options = options | append: "<option " | append: val | append: ">" -%}
                  {%- assign ans-upper = answer | upcase -%}
                  {%- assign options = options | append: ans-upper -%}
                  {%- assign options = options | append: "</option>" -%}
                {%- endfor -%}

                {{ options }}
              </select>&nbsp;
            {%- endunless -%}
          {%- endfor -%}
        </li>
      {%- endfor -%}
    </ol>
  </form>