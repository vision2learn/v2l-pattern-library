{%- comment %} Get course data {%- endcomment %}
{%- import "course-vars.njk" as courseVars %}
{%- set courseData = allcourses[module.course] %}

<section class="t-bg-primary">
  <h2>Unit overview</h2>
  <p>
    Press on each circle below to see which learning topics will be covered in each session of Unit {{ unit-num }}. 
  </p>
  <div class="tabbed ">
    <ul class="l-btn-group t-bg-primary">
      {%- for session in courseData.units[module.unit - 1].sessions %}
        <li>
          {%- include 'unit-overview-button', num: forloop.index %}
        </li>
      {%- endfor %}
    </ul>

    {%- for session in courseData.units[module.unit - 1].sessions %}
      <section id="section{{ forloop.index }}">
        <h3>Session {{ forloop.index }} - "{{ session[0] | capitalize }}" topics:</h3>
        <ul>
          {%- for item in session[1] %}
            <li>{{ item }}</li>
          {%- endfor %}
        </ul>
      </section>
    {%- endfor %}
  </div>
</section>
