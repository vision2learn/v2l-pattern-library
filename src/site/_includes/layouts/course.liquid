---
layout: layouts/default
---

{% include logic/course-vars %}

<header>
  <p>
    <b class="visually-hidden">Course: </b>{{ course-title | capitalize }} level {{ currentCourse.level }} 
    &gt; {{ unit-title | capitalize }} <b class="visually-hidden">(Unit {{ unit-num }} of {{ currentCourse.units.length }})</b>
    &gt; {{session-title | capitalize }} <b class="visually-hidden">(Session {{ session-num }} of {{ currentUnit.sessions.length }})</b>
  </p>

</header>

<main id="main">
  <h1>{{ title }}</h1>

  {{ content }}
</main>

<aside>
  {% include components/course-nav %}
</aside>

<nav>
  Pagination
</nav>

<footer>
  &copy; Vision2Learn
</footer>