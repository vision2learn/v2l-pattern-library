---
layout: layouts/course2
---

{% for section in module.data.sections %}
  {% block section %}
    <section id="{{ section.title | replace(' ', '-')}}" {% if section.theme %}class="{{ section.theme }}"
    {% endif %}>

    {% if section.include %}
      {% include 'components/' + section.include + '.njk' ignore missing %}
    {% elseif section.layout == "media" or section.layout == "media-rev" %}
      {% include 'components/media.njk' ignore missing %}
    {% else %}
      <h2>{{ section.title | title }}</h2>
      
      {% if section.copy %}
        {{ section.copy | markdownify | safe }}
      {% endif %}

      {% if section.subInc %}
        {% include 'components/' + section.subInc + '.njk' ignore missing %}
      {% endif %}
    {% endif %}
    </section>
  {% endblock section %}
{% endfor %}