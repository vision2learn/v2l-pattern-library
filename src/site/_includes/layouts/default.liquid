<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <meta http-equiv="X-UA-Compatible" content="ie=edge">
  <title>{%- if title %}{{ title }}{%- else %}{{ site.title }}{%- endif %}</title>
  <script src="https://unpkg.com/@webcomponents/webcomponentsjs@2.2.10/webcomponents-loader.js"></script>
  <script src="https://unpkg.com/@webcomponents/webcomponentsjs@2.2.10/custom-elements-es5-adapter.js"></script>
  <link href="https://fonts.googleapis.com/css?family=Open+Sans" rel="stylesheet"> 
  <link rel="stylesheet" href="/css/main.css">
  {%- if theme %}
    <link rel="stylesheet" href="/css/themes/{{ theme.name }}.css">
  {%- endif %}
   <script type="text/javascript" src="https://identity.netlify.com/v1/netlify-identity-widget.js"></script>
</head>

{%- if tags[0] == "components" %}
  {%- assign body-class = "component" %}
{%- endif %}

<body class="{{ body-class }}" data-v2l-env="{{ site.env }}">
  <div class="l-wrapper" >
    <a href="#main" class="skip-link visually-hidden">Skip to main content</a>
    {{ content }}
  </div>
  {% comment %} <script src='/js/animateload.js'></script> {% endcomment %}
  <script>

    
    var animateVars = {};
    var AdobeAn = {};

    (function() {
      
      if(document.querySelectorAll('.c-interactive').length > 0) {
        attachHandlers();
      }

      function attachHandlers() {
        document.querySelectorAll('[data-v2l-loadbtn]').forEach(function(btn) {
          btn.addEventListener('click', loadCanvas);
        });
      }

      function loadCanvas() {
        // Is there a canvas element on the page already?
        var canvasLoaded = document.querySelector('.c-interactive > canvas');
    
        if(canvasLoaded) {
          canvasLoaded.parentElement.replaceWith(animateVars.activeCanvas);
        }

        animateVars.activeCanvas = this.parentElement.cloneNode(true);
        {% comment %} console.log(animateVars.activeCanvas); {% endcomment %}
        // console.log(AdobeAn);
        var canvas = document.createElement('canvas');
        canvas.id = +new Date();

        animateVars.fileRef = this.parentElement.dataset.v2lInteractive;
        animateVars.compRef = this.parentElement.dataset.v2lComp;
        animateVars.canvasID = canvas.id;
        
        this.replaceWith(canvas);
        attachHandlers();

        loadAnimateJS();
         
        
        
      }
      function loadAnimateJS() {
        {% comment %} console.log(animateVars); {% endcomment %}
        if(!animateVars.loaded) {
          var scripts = [
            '//code.createjs.com/createjs-2015.11.26.min.js',
            '/js/interactive/'+ animateVars.fileRef +'.js',
            '/js/interactive/init.js'
          ].forEach(function(src) {
            var script = document.createElement('script');
            script.src = src;
            script.async = false;
            document.head.appendChild(script);
          });

          animateVars.loaded = true;
        }
        else {
          AdobeAn = {};
         // var scriptsLoaded = false;

          Array.prototype.forEach.call(document.scripts, function(script) {
            if(script.src.indexOf('/js/interactive/'+ animateVars.fileRef +'.js') > 0) {
              scriptsLoaded = true;
            }
          });
          //console.log(animateVars.canvasID, ' ', scriptsLoaded, ' ', animateVars);
          //if(scriptsLoaded) {
          //  console.log(document.getElementById(animateVars.canvasID), ' ', animateVars.canvasID);
          //  init(animateVars.canvasID, animateVars.compRef, animateVars.fileRef);
          //}
          //else {
            var scripts = [
              '/js/interactive/'+ animateVars.fileRef +'.js',
              '/js/animateload.js'
            ].forEach(function(src) {
              var script = document.createElement('script');
              script.src = src;
              script.async = false;
              document.head.appendChild(script);
            });
          //}
        }
      }
      
      // detect ES6 support, then load the main script file if OK
      try {
        new Function("(a = 0) => a");
        
        var script = document.createElement("script");
        script.src = "/js/script.js";
        document.head.appendChild(script);

      }
      catch (err) {
        return false;
      }
    })();

    if (window.netlifyIdentity) {
      window.netlifyIdentity.on("init", user => {
        if (!user) {
          window.netlifyIdentity.on("login", () => {
            document.location.href = "/admin/";
          });
        }
      });
    }

  </script>
</body>
</html>
