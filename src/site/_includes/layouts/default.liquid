<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <meta http-equiv="X-UA-Compatible" content="ie=edge">
  <title>{%- if title %}{{ title }}{%- else %}{{ site.title }}{%- endif %}</title>
  <script src="https://unpkg.com/@webcomponents/webcomponentsjs@2.2.10/webcomponents-loader.js"></script>
  <script src="https://unpkg.com/@webcomponents/webcomponentsjs@2.2.10/custom-elements-es5-adapter.js"></script>
  <link href="https://fonts.googleapis.com/css?family=Open+Sans" rel="stylesheet"> 
  <link rel="stylesheet" href="/css/main.css">
  {%- if theme %}
    <link rel="stylesheet" href="/css/themes/{{ theme.name }}.css">
  {%- endif %}
</head>

{%- if tags[0] == "components" %}
  {%- assign body-class = "component" %}
{%- endif %}

<body class="{{ body-class }}" data-v2l-env="{{ site.env }}">
  <div class="l-wrapper" >
    <a href="#main" class="skip-link visually-hidden">Skip to main content</a>
    {{ content }}
  </div>
  {% if site.env == 'netlify' %}
    <style>
      .toolbar {
        background: var(--secondary2);
        border-bottom: solid black 1px;
        box-shadow: 0 0 10px 8px rgba(0,0,0,.4);
        color: white;
        display: flex;
        justify-content: space-between;
        align-items: center;
        position: sticky;
        top: 0;
        padding: .5rem 1rem;
        z-index: 20;
        filter: opacity(20%);
        transition: filter .3s ease-in-out;
      }

      .toolbar:hover,
      .toolbar:focus {
        filter: opacity(100%);
      }

      .toolbar > button {
        all: unset;
      }

      .netlify-identity-menu {
        display: flex;
        list-style-type: none;
        padding: 0;
      }
    </style>

    <div class="toolbar">
      <div data-netlify-identity-menu></div>
      <a href="/feedback/" id="feedbackBtn" data-v2l-activity="true">Feedback</a>
    </div>

    <script>
      const fbk = document.getElementById('feedbackBtn');

      fbk.addEventListener('click', () => console.log('click'));
    </script>
  {% endif %}
  <script>
    {% include 'bodyscript' %}
  </script>
</body>
</html>
