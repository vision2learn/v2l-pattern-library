<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <meta http-equiv="X-UA-Compatible" content="ie=edge">
  <title>{%- if title %}{{ title }}{%- else %}{{ site.title }}{%- endif %}</title>
  <script src="https://unpkg.com/@webcomponents/webcomponentsjs@2.2.10/webcomponents-loader.js"></script>
  <script src="https://unpkg.com/@webcomponents/webcomponentsjs@2.2.10/custom-elements-es5-adapter.js"></script>
  <link href="https://fonts.googleapis.com/css?family=Open+Sans" rel="stylesheet"> 
  <link rel="stylesheet" href="/css/main.css">
  {%- if theme %}
    <link rel="stylesheet" href="/css/themes/{{ theme.name }}.css">
  {%- endif %}
</head>

{%- if tags[0] == "components" %}
  {%- assign body-class = "component" %}
{%- endif %}

<body class="{{ body-class }}" data-v2l-env="{{ site.env }}">
  <div class="l-wrapper" >
    <a href="#main" class="skip-link visually-hidden">Skip to main content</a>
    {{ content }}
  </div>
  <script>
    {% include 'bodyscript' %}
  </script>
</body>
</html>
