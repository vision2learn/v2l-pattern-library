---
permalink: dotnet/{{ module.data.course | slug }}/Unit0{{ module.data.unit}}/Session0{{ module.data.session }}/Page{{ pagination.pageNumber + 1 }}.cshtml
---
{%- import 'components/all.njk' as components -%}

  {% include 'banner.njk' %} 
  {# {{ components.banner(title=module.data.title, copy=module.data.intro, image=module.data.banner, unit=module.data.unit, session=module.data.session, pageNo=pagination.pageNumber, lastpage=lastPage, sessionMap=site.sessionMap) }} #}
  
  {%- if pagination.pageNumber == 0 and module.data.session == 1 -%}
    {%- include 'components/unit-overview-tabs.njk' -%}
  {%- endif -%}
  
  {{ content | safe }}

  {%- if pagination.pageNumber == 0 and module.data.session == 1 -%}
    <section>
      <h2>Course features</h2>
      {% include "course-features.njk" %}
    </section>
    <section class="t-bg-primary">
      {{ components.media(
          title="Submitting Assessments",
          copy="Once you’ve completed all Assessment questions in a Unit, you will need to send your completed Assessment to your tutor. Watch this video to see how.",
          layout="media-half",
          video="Submitting_Assessment_Recording.mp4"
      ) }}
    </section>
  {%- endif -%}
