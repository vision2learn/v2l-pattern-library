---
layout: layouts/default
permalink: courses/{{ module.data.course | slug }}/unit-{{ module.data.unit}}/session-{{ module.data.session }}/{{ module.data.title | slug }}/index.html
---
{% include 'course-vars.liquid' %}

{% include 'header.liquid' %}

<main id="main">
  
  {% include 'banner.liquid' %}
  
  {%- if pagination.pageNumber == 0 and module.data.session == 1 -%}
    {%- include 'unit-overview-tabs.liquid' -%}
  {%- endif -%}
  
  <!-- module.templateContent --> 
  {{ module.templateContent }}
  <!-- Content -->
  {{ content | safe }}

  {%- if pagination.pageNumber == 0 and module.data.session == 1 -%}
    <section>
      <h2>Course features</h2>
      {% include "course-features.liquid" %}
    </section>
    {% include "submitting-assessments.njk" %}
  {%- endif -%}

</main>

<aside hidden>
  {% include 'using-the-site.liquid' %}
  {% include 'course-nav.liquid' %}
</aside>

<footer>
  <small>
    &copy; Copyright Creating Careers Limited, 2019. All rights reserved. 
  </small>
</footer>