---
layout: layouts/default
permalink: courses/{{ module.data.course | slug }}/unit-{{ module.data.unit}}/session-{{ module.data.session }}/{{ pagination.pageNumber }}/index.html
---


{% include 'header.njk' %}
{% import 'components/all.njk' as components %}

{# {%- if pagination.lastPageHref == page.url -%}
  {%- set lastPage = true -%}
{%- endif -%} #}
<main id="main" data-v2l-tags="{{ tags }}">
  {{ components.banner(title=module.data.title, copy=module.data.intro, image=module.data.banner, unit=module.data.unit, session=module.data.session, pageNo=pagination.pageNumber, lastpage=lastPage, sessionMap=site.sessionMap) }}
  
  <!-- Content -->
  {{ content | safe }}

</main>

{{ components.pagination(class='t-bg-secondary1 boxout-small', pagination=pagination, page=page) }}
<footer>
  <small>
    &copy; Copyright Creating Careers Limited, 2019. All rights reserved. 
  </small>
</footer>

<script>
(function() {
  if(document.querySelectorAll('.c-quiz__answer > input')) {
    var inputs = document.querySelectorAll('.c-quiz__answer > input');

    inputs.forEach(function(el) {
      el.addEventListener('click', function(e) {
        console.log(e);
        e.preventDefault();
      });
    })
  }
})();
</script>