{%- unless module -%}
  {%- assign banner = default-data.banner -%}
{%- else -%}
  {%- assign banner-img = module.data.banner | prepend: '/images/banners/' -%}
{%- endunless -%}

{%- case module.data.session -%}
  {%- when 1 -%}
    {%- assign sessionIs = "first" -%}  
  {%- when 2 -%}
    {%- assign sessionIs = "second" -%}  
  {%- when 3 -%}
    {%- assign sessionIs = "third" -%}  
  {%- when 4 -%}
    {%- assign sessionIs = "fourth" -%}  
  {%- when 5 -%}
    {%- assign sessionIs = "fifth" -%}  
  {%- when 6 -%}
    {%- assign sessionIs = "sixth" -%}  
  {%- when 7 -%}
    {%- assign sessionIs = "seventh" -%}  
  {%- when 8 -%}
    {%- assign sessionIs = "eighth" -%}  
  {%- when 9 -%}
    {%- assign sessionIs = "ninth" -%}  
  {%- when 10 -%}  
    {%- assign sessionIs = "tenth" -%}
  {%- else -%}
    {%- assign sessionIs = "--- not defined ---" -%}
{%- endcase -%}

{%- if pagination.lastPageHref == page.url -%}
  {%- assign lastPage = true -%}
  {%- assign bannerTitle = "What did you learn?" -%}
  {%- assign bannerText = "Well done, you’ve now completed the " | append: sessionIs | append: " session of this unit!" -%}
{%- else -%}
  {%- assign bannerTitle = module.data.title | default: banner.title -%}
  {%- assign bannerText = module.data.intro | default: banner.text -%}
{%- endif -%}

<section class="c-banner" data-session="{{ module.data.session }}">
  <div class="c-banner__text boxout">
    <h1>{{ bannerTitle }}</h1>
      {{ bannerText | escape | markdownify }}
      {% comment %} 
        TODO: List out previous page titles when on final page
      {% endcomment %}
  </div>
  <img src="{{ banner-img | default: banner.img }}" class="c-banner__img" alt="">
</section>