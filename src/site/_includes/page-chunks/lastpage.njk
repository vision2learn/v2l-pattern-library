<!-- {{module.unit}} and {{unitsInCourse}}... -->
{# {%- if (module.unit === unitsInCourse) and (module.session === sessionsInUnit) %} #}
{%- if module.session === sessionsInUnit %}
  <section class="t-bg-supporting3">
    {%- set link = "~/" + module.unit + "/quiz" %}
    {{ components.media2({
        title: "Unit Quiz",
        copy: "Now it’s time to complete the End of Unit Quiz",
        media: {
          ref: "unit_quiz_button.svg",
          link: link
        }
      },
      site.env
    ) }}
  </section>
{%- endif %}

{% if module.session === 1 %}
  {% set assCopy = "Now it’s time to complete Part " + module.session + " of your Unit " + module.unit + " Assessment which counts towards your qualification. Remember to save the document to your computer. Use your notes on the assessment so far, and answers from any Time to " + timeToWhat + " journals to help you." %}
{% elif shortcode === 'it2' or shortcode === 'it1' %}
  {% set assCopy = "Now that you have completed this session, you should complete the relevant section in the assessment booklet. If you have not already done so, please [download and save the assessment file]("+ assLink +") in a suitable location on your computer. Use your notes on the assessment so far, and the work you have done in your 'Time to practice' activities to assist you" %}
{% else %}
  {% set assCopy = "Now that you have completed this session, you should complete the relevant section in the assessment booklet. If you have not already done so, please click on the assessment link to the right, then download and save the assessment file in a suitable location on your computer." %}
{% endif %}

<section>
  {% set assLink = "~/" + module.unit + "/assessment" %}
  {{ components.media2({
        title: "Unit assessment",
        copy: assCopy,
        media: {
          ref: "assessment_button.svg",
          link: assLink
        }
      },
      site.env
    ) }}
</section>

{% if module.session === 1 %}
  {{ components.section({
      title: "Hints & Tips",
      copy: "Take a look at this unit's Hints and Tips booklet (which you can download) which will help you when you come to complete the assessment:\n\n[Unit " + module.unit + " Hints and Tips](" + tilde + "/pdfs/" + shortcode + "_u" + module.unit + "_s"+ module.session +"_p1_hints_u" + module.unit + ".pdf)",
      theme: "t-bg-primary2 i-read"
    }) }}
{% endif %}

{% if (shortcode === 'it2' or shortcode === 'it1') %}
  {# Session 1 OR Last session in last unit #}
  {% if (module.session === 1) or (module.unit == unitsInCourse and module.session == sessionsInUnit) %}
    <section class="t-bg-grey i-watch">
      {%- set course = module.course | replace(" ", "-") %}
      {{ components.media2({
        title: "Watch the webinar",
        copy: "To assist you with your assessment please watch this video which provides guidance on how to complete the assessment questions for this section.",
        layout: "media-half",
        media: {
          ref: "webinars/" + course + "/unit-" + module.unit + ".mp4"
        }
      },
      site.env
      ) }}
    </section>  
  {% endif %}
{% else %}
  <section class="t-bg-grey i-watch">
    {%- set course = module.course | replace(" ", "-") %}
    {{ components.media2({
      title: "Watch the webinar",
      copy: "To assist you with your assessment please watch this video which provides guidance on how to complete the assessment questions for this section.",
      layout: "media-half",
      media: {
        ref: "webinars/" + course + "/unit-" + module.unit + "-session-" + module.session + ".mp4"
      }
    },
    site.env
    ) }}
  </section>
{% endif %}

<section class="t-bg-primary">
  {# We're done! #}
  {%- if (module.unit == unitsInCourse) and (module.session == sessionsInUnit) %}
    <h2>Congratulations!</h2>
    <p>
      You've reached the end of this course.
    </p>
  {%- else %}
    {%- set link = "/courses/" + module.course + "/unit-" + nextUnit + "/session-" + nextSession + "/1" %}
    {% if site.env === 'dotnet' %}
      {% set link = "~/" + nextUnit + "/" + nextSession + "/1" %}
    {% endif %}
    {%- set link = link | replace(' ', '-') %}

    {% if module.session == sessionsInUnit %}
      {%- set moveOnText = "Once you’ve finished your assessment and sent it to your tutor for marking, you can move on to the next unit." -%}
      {% set altText = "Next unit" %}
    {%- else -%}
      {%- set moveOnText = "Once you’ve finished this part of your assessment, you can move on to the next session." -%}
      {% set altText = "Next session" %}
    {% endif %}

    {{ components.media2({
        title: "Ready to move on?",
        copy: moveOnText,
        media: {
          ref: "next_button.svg",
          link: link,
          alt: altText
        }
      },
      site.env
    ) }}
  {%- endif %}
</section>
