{# 
  If module.sections is empty, assume this is for documentation pages and pull data from _data/examples
#}
{% set sections = module.sections %}
{% if not module.sections %}
  {% set sections = examples.sections %}
{% endif %}

{# 
  Loops through the content in the 'sections' key within the data (.yml) files
#}
{%- for section in sections %}
  {% set themeIcon = false %}
  {%- if section.theme and section.theme.indexOf("i-") > -1 -%}
    {% set themeIcon = true %}
  {%- endif -%}

  {# 
    Only write out sections with data.
    Legacy issue caused by double hyphens '-' in the data file creating empty sections 
  #}
  {% if section.title %}
    {%- if section.theme == "i-quiz" and lastPage and (sessionCount == session) %}
      {# {{ section.title }} #}
    {% else %}
      {%- if section.include %}
      <!-- A -->
        {%- set inc = section.include.type | lower %}
        {%- include 'components/' + inc + '.njk' ignore missing %}
      {%- elseif section.activity -%}
        {%- set link = "/captivate/" + shortcode + "/" + section.activity.ref + "/" -%}
        {{ components.buttonSection({
            type: 'activity',
            title: section.title,
            copy: section.copy,
            theme: section.theme,
            unit: unit,
            tilde: site.tilde,
            link: link
          }) }}

      {%- elseif section.title.toLowerCase() == 'forum' -%}
        {{ components.buttonSection({
            type: 'forum',
            copy: section.copy,
            theme: section.theme,
            unit: unit,
            tilde: site.tilde
          }) }}
      {%- else %}
        <section id="{{ section.title | replace(' ', '-') | lower }}" {% if section.theme %} class="{{'t-bg-supporting3 i-quiz' if section.theme == 'i-quiz' else section.theme }}"{% endif %}>
          {% if section.layout and section.layout.indexOf('media') > -1 and not section.video%}

            {%- set mediaItem -%}
              {{- section.img if section.img -}}
            {%- endset -%}
            
            {%- if section.activity -%}
              {{ components.media2(
                {
                  title: section.title,
                  copy: section.copy,
                  layout: section.layout,
                  media: {
                    link: section.activity.ref,
                    ref: 'activity'
                  }
                },
                site.env,
                course
              ) }}
            {%- else -%}
              {{ components.media2({
                  title: section.title,
                  copy: section.copy,
                  layout: section.layout,
                  media: {
                    ref: mediaItem,
                    link: section.link
                  }
                }, site.env) }}
            {%- endif -%}
          {% else %}
            <h2>{{ components.icon(section.theme) if (section.theme and section.theme.indexOf("i-") > -1) }}{{ section.title }}</h2> 
            
            {%- if section.copy %}
              {{ section.copy | markdownify | safe }}
            {%- endif %}

            
            {%- if section.video %}
              <!-- sections.njk VIDEO! -->
              {% set mediaObj = section.video | lower %}
              {% set id = section.title | d('') | slug %}
              {% video mediaObj, id %}
            {%- endif %} 
           
            
            {%- if section.subInc %}
              {# Is this a basic or more complex include type? #}
              {# {%- set inc = section.subInc %} #}

              {%- set inc = section.subInc.type | lower %}
              
              {%- if inc %}
                {%- include 'components/' + inc + '.njk' %}
              {%- endif %}
            {% endif %}

            {%- if section.copy2 %}
              {{ section.copy2 | markdownify | safe }}
            {%- endif %}

            {%- if section.interactive %}
              {%- include 'components/animate-canvas.njk' %}
            {%- endif %}
          {% endif %}
        </section>
      {% endif%}  
    {% endif%}
  {% endif %}   
    {# {%- endblock section %} #}
{%- endfor %}
