{%- assign module-id = mod | default: module.data.id -%}

{%- assign pages = collections[module-id] -%}
{%- assign page-urls = '' -%}
{%- assign page-titles = '' -%}

{%- for p in pages -%}
  {%- assign pCourse = p.data.course | slug -%}
  {%- assign pUnit = p.data.unit | prepend: '/unit-' -%}
  {%- assign pSession = p.data.session | prepend: '/session-' -%}
  {%- assign pTitle = p.data.title | replace: ",", "&#44;" | slug | prepend: '/' -%}
  {%- assign page-urls = page-urls | append: pCourse | append: pUnit | append: pSession | append: '/' | append: forloop.index | append: '/' -%}
  {%- assign page-titles = page-titles | append: p.data.title | downcase -%}

  {%- unless forloop.last -%}
    {%- assign page-urls = page-urls | append: ', ' -%}
    {%- assign page-titles = page-titles | append: ', ' -%}
  {%- endunless -%}
{%- endfor -%}

{%- assign page-urls = page-urls | split: ', ' -%}
{%- assign page-titles = page-titles | split: ', ' -%}
