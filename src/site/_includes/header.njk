    </a>

    {% if page.url != '/login/' %}
      <p class="c-main-head__details">
        <span class="c-main-head__course">{{ fulltitle if fulltitle else course | replace("-", " ") | d("Course Title")}}</span>
        <span>Unit {{ unit | d("X")}} of {{ unitCount | d('X') }}: {{ unitName | replace("young peoples", "young people's") | d("Unit Name") | title }}</span>
        <span class="c-main-head__session">Session {{ session | d("X") }} of {{ sessionCount | d("X") }}: {{ sessionName | d("Session Name") | replace("Societys", "Society's") | title }}</span>
      </p>
      
      {{ pag(pagination=pagination, page=page) }}
      
      <ul class="c-main-head__sessions" aria-label="Sessions in unit {{ unit | d('X') }}" aria-role="navigation">
        {%- for i in range(0, sessionCount) %}
          <li><a href="/courses/{{ course | d('no string') | slug }}/{{ unit}}/{{ loop.index }}/1/" {% if loop.index == session %} aria-current="step" {% endif %}>Session {{ loop.index }}</a></li>
        {%- endfor %}
      </ul>
    {% endif %}

  </div>
</header>
