{%- from "components/all.njk" import unitOverviewBtn as button %}

{%- set unitData = courses[course] | courseinfo %}
{%- set thisUnit = unitData.keysOrdered[unit - 1] %}
{%- set sessionData = courses[course][thisUnit] | courseinfo -%}
{%- set thisSession = sessionData.keysOrdered[session - 1] %}

<section class="t-bg-primary" id="unit-overview">
  <h2>Unit overview</h2>
  <p hidden>
    Press on each circle below to see which learning topics will be covered in each session of Unit {{ unit }}. 
  </p>

  <div class="tabbed ">
    <ul class="l-btn-group t-bg-primary">
      {%- for i in range(0, sessionCount) %}
        <li>
          {{ button(loop.index) }}
        </li>
      {%- endfor %}
    </ul>

    {% for session in sessionData.keysOrdered %}
      {% set masterLoop = loop.index %}
      <section id="section{{ loop.index }}">
        <h3>Session {{ loop.index }} - "{{ session | replace("0" + loop.index, "") | d('error') | trim | capitalize }}" topics:</h3>
        <ul>
          {%- for pageNo, pageData in courses[course][thisUnit][session] %}
            {% if not loop.last %}
              <li>{{ pageData.title | title }}</li>
            {% endif %}
          {%- endfor %}
        </ul>
      </section>
    {% endfor %}
  </div>
</section>
