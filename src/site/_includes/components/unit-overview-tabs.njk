{% import "components/all.njk" as components %}
{% import "course-vars.njk" as courseVars %}
{%- set courseData = allcourses[module.data.course] -%}

<section class="t-bg-primary" id="unit-overview">
  <h2>Unit overview</h2>
  <p hidden>
    Press on each circle below to see which learning topics will be covered in each Session of Unit {{ module.data.unit }}. 
  </p>

  <div class="tabbed ">
    <ul class="l-btn-group t-bg-primary">
      {%- for session, breakdown in courseData.units[module.data.unit - 1].sessions -%}
        <li>
          {{ components.unitOverviewBtn(loop.index) }}
        </li>
      {%- endfor -%}
    </ul>

    {%- for session, breakdown in courseData.units[module.data.unit - 1].sessions -%}
      <section id="section{{ loop.index }}">
        <h3>Session {{ loop.index }} - "{{ session | capitalize }}" topics:</h3>
        <ul>
          {%- for item in breakdown -%}
            <li>{{ item }}</li>
          {%- endfor -%}
        </ul>
      </section>
    {%- endfor -%}
  </div>
</section>