{%- from "components/all.njk" import reveal as reveal %}
{%- if compData -%}
  <!-- IF 1 -->
  {%- set revealdata = compData.subInc -%}
{%- elseif section -%}
  <!-- IF 2 -->
  {%- set revealdata = section.subInc -%}
{%- endif -%}
<ul class="l-icon-grid {% if revealdata.layout %}l-icon-grid--{{ revealdata.layout }}{% endif %}" data-zzz='ffff'>
  
  {% if revealdata %}
    
    <!-- {{ module.shortcode }} -->
    {%- for revealItem in revealdata.content %}
      {{ reveal({
          heading: revealItem.title, 
          copy: revealItem.copy, 
          image: revealItem.img,
          shortcode: shortcode
        }, site.env) }}
    {%- endfor %}
  {% else %}
    {% set revealdata = defaultdata.courseFeatures %}
    <!-- {{ revealdata | dump }} -->
    {%- for key, val in revealdata %}
      {# Not ideal, but the first 9 in default data are the standard course features #}
      {% if loop.index < 10 %}
        {{ reveal({
            heading: key, 
            copy: val.copy, 
            image: "course-features/" + val.img
          }, site.env) }}
      {% endif %}
    {%- endfor %}
    
  {% endif %}
</ul>
