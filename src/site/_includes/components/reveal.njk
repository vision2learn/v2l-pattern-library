{%- from "components/all.njk" import reveal as reveal %}

<ul class="l-icon-grid {%- if section.subInc.layout %}l-icon-grid--{{ section.subInc.layout }}{%- endif %}">
  
  {% if section.subInc.content %}
    {% set revealdata = section.subInc.content %}
    <!-- {{ module.shortcode }} -->
    {%- for revealItem in revealdata %}
      {{ reveal({
          heading: revealItem.title, 
          copy: revealItem.copy, 
          image: revealItem.img,
          shortcode: module.shortcode
        }, site.env) }}
    {%- endfor %}
  {% else %}
    {% set revealdata = defaultdata.courseFeatures %}
    
    {%- for key, val in revealdata %}
      {# Not ideal, but the first 9 in default data are the standard course features #}
      {% if loop.index < 10 %}
        {{ reveal({
            heading: key, 
            copy: val.copy, 
            image: "course-features/" + val.img
          }, site.env) }}
      {% endif %}
    {%- endfor %}
    
  {% endif %}
</ul>
