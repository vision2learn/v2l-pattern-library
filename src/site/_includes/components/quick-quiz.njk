{% import 'components/all.njk' as components %}

{% if section.include %}
  {%- set quiz = section.include.content -%}
  {%- set mode = section.include.mode -%}
{% elseif section.subInc %}
  {%- set quiz = section.subInc.content -%}
  {%- set mode = section.subInc.mode -%}
{% else %}
  {%- set quiz = defaultdata.wordQuiz.sentences -%}
{% endif %}

{% if mode == "multi-choice" %}
  {% set qType = "checkbox" %}
{% endif %}


<form action="#q-loop.index" class="c-quiz c-quiz--quick l-quiz" id="q-loop.index">
  {%- for question, answers in quiz -%}
    {%- set topIndex = loop.index -%}
      <fieldset class="l-quiz">
        <legend class="c-quiz__legend l-vc">{{ question }}</legend>
        
        {%- for response, result in answers.answers -%}
          <div class="c-quiz__answer l-vc">
            {{ components.quizQuestion(type=qType, qNumber=topIndex, aNumber=loop.index, answer=response, trueOrFalse=result) }}
          </div>
        {%- endfor -%}
      
      <input type="submit" value="Submit answers for question {{ loop.index }}" hidden>
      <p class="c-quiz__fb" hidden data-v2l-feedback="{{ answers.feedback }}">
        {{ answers.feedback }}
      </p>

      </fieldset>
  {%- endfor -%}
</form>