{#
  Reusable code components in this file:

  1. Pagination 
  2. Responsive Images
  3. Unit Overview Buttons
  4. Quick Quiz
  5. Accordion
  6. Banner
  7. Section
  8. Media Object
  9. Slider
  10. Reveal
#}

{# --- 1. Pagination--- #}

{% set sitename = site.v2l %}

{%- macro pagination(class, pagination, page) %}
  <nav class="{{ class if class }}" aria-label="Pages in this session">
    <ol role="list" class="c-pagination">
      {%- if pagination.previousPageHref %}
        <li class="c-pagination__prev" role="listitem">
          <a href="{{ pagination.previousPageHref }}">
            <i class="visually-hidden">Previous Page</i>
            <svg aria-hidden="true" focusable="false" xmlns="http://www.w3.org/2000/svg" width="21" height="28"><path d="M18.297 4.703L10 13l8.297 8.297a.99.99 0 0 1 0 1.406l-2.594 2.594a.99.99 0 0 1-1.406 0L2.703 13.703a.99.99 0 0 1 0-1.406L14.297.703a.99.99 0 0 1 1.406 0l2.594 2.594a.99.99 0 0 1 0 1.406z"/></svg>
          </a>  
        </li>
      {%- endif %}

      {# <!-- TODO: Re-order visually with CSS --> #}
      {%- if pagination.nextPageHref %}
        <li class="c-pagination__next" role="listitem">
          <a href="{{ pagination.nextPageHref }}">
            <i class="visually-hidden">Next Page</i>
            <svg aria-hidden="true" focusable="false" xmlns="http://www.w3.org/2000/svg" width="19" height="28"><path d="M17.297 13.703L5.703 25.297a.99.99 0 0 1-1.406 0l-2.594-2.594a.99.99 0 0 1 0-1.406L10 13 1.703 4.703a.99.99 0 0 1 0-1.406L4.297.703a.99.99 0 0 1 1.406 0l11.594 11.594a.99.99 0 0 1 0 1.406z"/></svg>
          </a>
        </li>
      {%- endif %}

      {%- for href in pagination.hrefs %}
        {# <!-- TODO: Review component with VoiceOver --> #}
        <li role="listitem">
          <a href="{{ href }}" {% if page.url == href %} aria-current="page"{% endif %}>{{ loop.index }}</a>
        </li>
      {%- endfor %}
    </ol>
  </nav>

{%- endmacro %}

{# --- 2. Responsive Images--- #}

{%- macro img(file, class, alt, type, env) -%}
  {#- These widths mirror those set in the images.js gulp task -#}
  {%- set widths = [400, 600, 800, 1000, 2000] -%}
  
  {#- Set basepath to image folder -#}
  {#- TODO: Alter value based on type var -#}
  {#- {%- set basepath = "/images/" %} -#}

  {#- split name and extension from filename -#}
  {%- set basefile = file.split('.') -%}

  {#- Use the file name and widths to build up the srcset attribute -#}
  {%- set srcset -%}
    {%- set comma = joiner() -%}
    {%- for width in widths %}
      {{ comma() }} {{ '~' if env === 'dotnet' }}{{ basefile[0] + "-" + width + "." + basefile[1] | lower }} {{ width + "w"}}
    {%- endfor %}
  {%- endset %}
  <img
    {%- if class %} class="{{ class }}" {%- endif %}
    src='{{ "~" if env === "dotnet" }}{{ basefile[0] + "-" + widths[1] + "." + basefile[1] }}'
    srcset="{{ srcset | trim }}"
    sizes="100vw"
    alt='{{ alt }}'>
{%- endmacro -%}

{# --- 3. Unit Overview Buttons--- #}
{%- macro unitOverviewBtn(num) %}
<a class="c-unit-btn" href="#section{{ num }}">
  <span>
    {{ num }}
  </span>
</a>
{%- endmacro %}

{# --- 4. Quick Quiz --- #}

{%- macro quizQuestion(type, qNumber, aNumber, answer, trueOrFalse) %}
  <input autocomplete="off" type="{{ type | d('radio') }}" name="qq-{{ qNumber }}" id="q{{ qNumber }}-a{{ aNumber }}" value="{{ answer | lower | replace(' ', '_')}}">
  <label for="q{{ qNumber }}-a{{ aNumber }}" data-v2l-correct="{{ trueOrFalse }}" >
    {%- if answer == "true" or answer == "false" %}
      {{ answer | capitalize }}
    {%- else %}
      {{ answer }}
    {%- endif %}
    
  </label>
{%- endmacro %}

{# 
--- 5. Accordion --- 

Taken from: https://inclusive-components.design/collapsible-sections/

#}

{%- macro accordion(data, env) %}
<toggle-section open="false">
  {%- if data.img %}
    {{ media2({
      title: data.title,
      copy: data.copy,
      media: {
        ref: data.img
      }
    }, env) }}
  {%- else %}
    <h3>{{ data.title | d("Title") }}</h3>
    {{ data.copy | markdownify | safe }}
  {%- endif %}
</toggle-section>
{%- endmacro %}

{# --- 6. Banner --- #}

{%- macro banner(title="Banner title", copy="Banner copy", image="PLACEHOLDER.jpg", unit=1, session=1, pageNo=1, lastpage=false, sessionMap) %}
  {%- from "components/all.njk" import img as srcset %}

  {%- set bannerTitle = title %}
  {%- set bannerText = copy %}
  {%- set banner = "/images/banners/" + image %}

  {%- set sessionIs = sessionMap[session - 1] %}
  
  {%- if lastpage %}
    {%- set bannerTitle = "What did you learn?" %}
    {%- set bannerText = "Well done, you’ve now completed the " + sessionIs + " session of this unit!\n\n" + copy %}
  {%- elseif pageNo == 1 and session == 1 and unit == 1 %}
    {%- set bannerTitle = "Your learning goals" %}
    {%- set bannerText = "Work hard throughout your " + module.course  + " course and be honest about the effort you put into each session.\n\nFocus on your learning goals and you may be surprised by how much you can achieve." %}
  {%- endif %}

  <section class="c-banner" data-session="{{ session }}">
    <div class="c-banner__text boxout">
      <h1>{{ title }}</h1>
      {{ bannerText | markdownify | safe }}
    </div>
    {%- if banner.endsWith('.svg') %}
      <img src="{{ '~' if module.buildenv === 'dotnet' }}{{ banner | lower }}" class="c-banner__img" alt="">
    {%- else %}
      {{ srcset(file=banner, class="c-banner__img")}}
    {%- endif %}
  </section>

{%- endmacro %}

{# 7. Section 
  Arguments:
    section (object) - found in individual page front matter or from predefined in _data/sections.json...
#}

{%- macro section(section) %}

  <section id="{{ section.title | replace(' ', '-') | lower }}" {%- if section.theme %}class="{{ section.theme }}"{%- endif %}>
    {%- if section.layout %}
      {{ media(title=section.title, copy=section.copy, img=section.img, video=section.video, activity=section.activty, think=section.think, layout=section.layout) }}
    {%- else %}
      <h2>{{ section.title }}</h2>

      {%- if section.copy %}
          {{ section.copy | markdownify | safe }}
        {%- endif %}
        
        {%- if section.subInc %}
          {# Is this a basic or more complex include type? #}
          {# {%- set inc = section.subInc %} #}

          {%- set inc = section.subInc.type %}
          
          {%- include 'components/' + inc + '.njk' %}

        {%- endif %}

        {%- if section.copy2 %}
          {{ section.copy2 | markdownify | safe }}
        {%- endif %}

    {%- endif %}
    
  </section>

{%- endmacro %}

{# 
--- 8. Media object --- 

  params:
    data: {
      title (o): String, 
      copy (r): String/markdown,
      layout (o): String: "media-rev" || "media-half"
      media (r): {
        ref (r): String: path/to/file
        link (o): href to link out to, images only
      }
    }
    env: build environment from module pagination object

#}

{%- macro media2(data, buildenv, course="", formID=1) %}
  {# Remove leading slash from object path if there is one #}
  
  {%- if data.title === "Forum" -%}
    {%- set link = '/student-dotnet/group-forum.aspx' -%}
  {%- elseif data.media.link -%}
    {%- set link = data.media.link -%}
  {%- elseif data.link -%}
    {%- set link = data.link -%}
  {%- endif -%}

  {%- set  mediaObj = "" + data.media.ref | safe | striptags() %}
  {%- if mediaObj | first === "/"  %}
    {%- set  mediaObj = mediaObj | replace("/","",1) | replace("images/svg/", "", 1) %}
  {%- endif %}
  
  {# Detect media type, img/video etc #}
  {%- if (mediaObj.toString().endsWith('svg')) or (mediaObj.toString().endsWith('png')) or (mediaObj.toString().endsWith('jpg')) or (mediaObj.toString().endsWith('jpeg') or mediaObj.startsWith('https://via.placeholder')) %}
    {%- set mediaType = "image" %}
    {% set filepath = '/images/svg/' %}

    {% if mediaObj.startsWith('https://via.placeholder') %}
      {% set filepath = '' %}
    {% endif %}
  {%- elseif mediaObj.toString().endsWith('mp4') %}
    {%- set mediaType = "video" %}
  {%- elseif mediaObj === "activity" %}
    {%- set mediaType = "activity" %}
  {%- else %}
    {%- set mediaError = "Unrecongnised media type passed to media() in all.njk" %}
  {%- endif %}

  {% if mediaType !== 'video' %}
    <div class="l-media {%- if data.layout == 'media-rev' %} l-media--rev {%- elseif data.layout == 'media-half' %} l-media--half {%- endif %} {{ 'l-media--video' if mediaType === 'video' }}">
      {%- if data.title %}
        {# TODO: dynamic heading level #}
        <h2 class="l-media__title">
          {{ data.title }}
        </h2>
      {%- endif %}

      <div class="l-media__body {{ 'l-media__body--full' if not data.title }}">
        {{ data.copy | markdownify | safe }}

        {% if mediaType === "image" and data.title === "Stretch" and link %}
          <p>
            <small>vision&#x200B;2&#x200B;learn is not responsible for the content of external sites.</small>
          </p>
        {% endif %}
      </div>

      {%- if mediaType === "image" %}
        {%- if link %}
          <a href="{{ link }}" class="l-media__img" {{ "target=_blank rel=noopener" if data.title === "Stretch" }} aria-label="{{ data.media.alt if data.media.alt else data.title }}">
            <img src="{{ '~' if buildenv === 'dotnet' }}{{ filepath }}{{ mediaObj | lower }}" alt="{{ mediaError }}">
          </a>
        {% else %}
          <img class="l-media__img" src="{{ '~' if buildenv === 'dotnet' }}{{ filepath }}{{ mediaObj | lower }}" alt="{{ mediaError }}">
        {%- endif %}
      {%- elseif mediaType === "activity" %}
        <a href="{{ '~' if buildenv === 'dotnet' }}/captivate/{{ course | d('no string') | slug }}/{{ link }}/" class="l-media__img" data-v2l-activity=true>
          <img src="{{ '~' if buildenv === 'dotnet' }}/images/svg/activity_button.svg" alt="Begin {{ data.title }}">
        </a>
      {%- else %}
        <p>{{ mediaError + ": " + mediaObj }}</p>
      {%- endif %}  
    </div>
  {% else %}
    {%- set id = data.title | d('no string') | slug | uniqueID %}
    <h2 id="{{ id }}">{{ data.title }}</h2>
    {{ data.copy | markdownify | safe }}
    <!-- all.njk VIDEO 2 -->
    {% set mediaObj = mediaObj | lower %}
    {% video mediaObj, id %}
  {% endif %}
  
{%- endmacro %}

{# --- 9. Slider --- #}
{%- macro slideItem(slidedata, buildenv, shortcode) %}
  {# TODO: Support other media types for slider #}
    {%- if slidedata.heading -%}
      {%- set title = slidedata.heading | safe | striptags() -%}
    {%- elseif slidedata.title -%}
      {%- set title = slidedata.title | safe | striptags() -%}
    {%- else -%}
      {%- set title = "" -%}
    {%- endif -%}

    {%- if slidedata.img or slidedata.media %}
      {{ media2({
            title: title,
            copy: slidedata.text,
            media: {
              ref: '/' + shortcode + '/' + slidedata.img
            }
          },
          buildenv
        ) }}
    {%- else %}
     <div>
        {%- if slidedata.heading %}
          <h3>{{ slidedata.heading | safe }}</h3>
        {%- endif %}
        {{ slidedata.text | markdownify | safe }}
      </div> 
    {%- endif %}
    
    {# <span aria-hidden="true" class="c-slider__count" data-v2l-count="{{ slideData.length }}"></span> #}
{%- endmacro %}

{# 10. Reveal (show/hide) #}

{%- macro reveal(data, env) %}
  {# {% set imgSrc = "images/svg/" + data.shortcode + "/" + data.image | lower %} #}
  {% if data.shortcode %}
    {% set shortcode = data.shortcode + "/" %}
  {% endif %}
  <li class="c-reveal-block">
    <img class="c-reveal-block__icon js-showhide" src="{{ '~' if env === 'dotnet' }}/images/svg/{{ shortcode | d('') }}{{ data.image | lower }}" alt="{{ data.heading | d('Panel heading') }}">
    {# {% image imgSrc, "c-reveal-block__icon js-showhide", data.heading, "100vw" %} #}
    <div class="c-reveal-block__desc">
      <h3 aria-hidden="true">{{ data.heading | d('Panel heading') | capitalize }}</h3>
      {{ data.copy | markdownify | safe | d('Panel copy')}}
    </div>
  </li>
{%- endmacro %}
