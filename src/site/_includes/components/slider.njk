{%- if section %}
  {%- set slideData = section.subInc.slides %}
{%- else %}
  {%- set slideData = components.slider.slides %}
{%- endif %}

{%- from "components/all.njk" import slideItem as slider %}
<div class="gallery-container">
  <div role="group" class="gallery no-js">
    <ul>
      {%- for slide in slideData %}
        <li role="listitem">
          
          {{ slider(slide, site.env, shortcode) }}
        </li>
      {%- endfor %}
    </ul>
  </div>
</div>
