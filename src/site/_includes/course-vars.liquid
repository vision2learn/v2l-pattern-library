{% comment %} 
  Maps to the all-courses.json file in the _data directory. Course structure is detailed there
  module.data is the pagination object (from calling file, course.liquid), so module.data is the data object for each specific page in the collection
{% endcomment %}

{% comment %} Get course info for this specific page {% endcomment %}
{%- assign course-data = all-courses[module.data.course] -%}

{% comment %} Gets unit number from session-x.11tydata file, and subtracts by 1 for array looping {% endcomment %}
{%- assign unit-index = module.data.unit | minus: 1 -%}

{% comment %} Gets session number from session-x.11tydata file, and subtracts by 1 for array looping {% endcomment %}
{%- assign session-index = module.data.session | minus: 1 -%}

{% comment %} Gets unit name from all-courses.json using unit number as index {% endcomment %}
{%- assign this-unit = course-data.units[unit-index].title -%}

{% comment %} Gets session name from all-courses.json using session number as index {% endcomment %}
{%- assign this-session = course-data.units[unit-index].sessions[session-index] -%}