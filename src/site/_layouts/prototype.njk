---
layout: default
permalink: "courses/{{ course | d('no string') | slug }}/unit-{{ unit}}/session-{{ session }}/{{ pagination.pageNumber + 1}}/index.html"
---
{%- set unitNameFilter = "0" + unit -%}
{%- set sessionNameFilter = "0" + session -%}

{%- from 'components/all.njk' import pagination as pag %}
<!--
{{ unit }}
{{ session }}
-->
{%- include 'header.njk' %}

<main id="main" data-v2l-tags="{{ tags }}" data-v2l-course="{{ course }}" data-v2l-level="{{ level }}" data-v2l-unit="{{ unit }}" data-v2l-session="{{ session }}" data-v2l-page="{{ pagination.pageNumber }}">
  {{ content | safe }}
</main>

{% if page.url != '/login/' %}
  {{ pag(class='t-bg-secondary1 boxout-small', pagination=pagination, page=page) }}
{% endif %}
<footer>
  <small>
    &copy; Copyright {{ site.v2l | safe }}, {{ site.date().year }}. All rights reserved (Env: {{ site.env }}). 
  </small>
</footer>
