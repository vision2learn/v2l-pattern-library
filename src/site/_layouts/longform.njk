      {% if site.env === 'netlify' %}
        <div data-netlify-identity-menu></div>
      {% else %}
        <div data-netlify-identity-menu="" style="width: 100%;">
          <ul class="netlify-identity-menu">
            <li class="netlify-identity-item netlify-identity-user-details">Logged in as <span class="netlify-identity-user">fake.login@nothing.com</span></li>
            <li class="netlify-identity-item" style="width: max-content;"><a class="netlify-identity-logout" href="#">Log out</a></li>
          </ul>
        </div>
      {% endif %}
      
    </header>  
    <aside>
      <h2>Documentation</h2>
      <nav class="d-nav">
        {{ collections.all | eleventyNavigation | eleventyNavigationToHtml | safe }}
      </nav>
    </aside>
    <main id="main">
      {{ content | safe }}
    </main>
    <footer>
      <p>&copy; 2021 {{ site.v2l | safe }} <small>Site updated: {{ site.date().build }}</small></p>
    </footer>
  </div>
  <script>
  {% include 'bodyscript.liquid' %}
  </script>
</body>
</html>
