---
layout: default
permalink: courses/{{ module.course | slug }}/unit-{{ module.unit}}/session-{{ module.session }}/{{ module.title | slug }}/index.html
---
{% include 'course-vars.njk' %}

{% include 'header' %}

<main id="main">
  
  {% include 'banner' %}
  
  {%- if pagination.pageNumber == 0 and module.session == 1 %}
    {%- include 'unit-overview-tabs' %}
  {%- endif %}
  
  {{ module.templateContent }}

  {%- if pagination.pageNumber == 0 and module.session == 1 %}
    {% include "submitting-assessments" %}
  {%- endif %}

</main>

<aside hidden>
  {% include 'using-the-site' %}
  {% include 'course-nav' %}
</aside>

<footer>
