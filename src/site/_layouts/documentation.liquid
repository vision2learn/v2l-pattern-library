---
layout: default
theme:
  name: prism-xonokai
---
{%- comment %} TODO: Dynamic collection loading is only possible in 11ty >= 0.7.2 {%- endcomment %}
{%- assign component-url = page.fileSlug | prepend: "/components/" %}

{%- comment %} {%- for item in collections.components %}
  {{ item.fileSlug }}<br>
  {%- if page.fileSlug == item.fileSlug %}
    {%- assign component = item %}
  {%- endif %}
{%- endfor %} {% endcomment %}

{% comment %} Use the dummy data file to populate components {% endcomment %}
{%- assign data = default-data[page.fileSlug] %}

<header>
  <h1>Component: {{ page.fileSlug | capitalize | replace: '-', ' '}}</h1>

  {%- if desc %}
    <p>
      {{ desc | markdownify }}
    </p>  
  {%- endif %}
</header>

<main>
  <section>
    {{ content }}
  </section>

  {%- unless no-include %}
    <section>
      <h2>Rendered Component</h2>
      <div style="border-top: dashed black 2px; border-bottom: dashed black 2px; padding: 2rem 0;">
        {% comment %} {% include page.fileSlug %} {% endcomment %}
      </div>
      <p>
        <a href="{{ component-url }}">View standalone component</a>
      </p>
      {% comment %} 
      TODO: Reimplement in 0.7.2
      <details>
        <summary>View rendered source for <code>{{ page.fileSlug }}</code></summary>
          {% highlight html %}      
          {{ component.templateContent | escape }}
          {% endhighlight %}
      </details>
      {% endcomment %}
    </section>
  {%- endunless %}
</main>
