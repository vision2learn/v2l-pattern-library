---js
{
  layout: (process.env.ELEVENTY_ENV === 'dotnet') ? 'dotnet.njk' : 'prototype.njk'
}
---

{# 
  Get individual folder names via folders filter => .eleventy.js #114 
  Returns object with keys:
    - course
    - unit
    - session
#}
{% set folders = pagination.data | folders %}

{# 
  moduleNum is alias for 11ty pagination object, set in all course template files => e.g. src/site/content/it-user-skills-2/u1-s1.njk
  It is effectively the filename
  11ty pagination => https://www.11ty.dev/docs/pagination/
  module is all of the data in an individual YAML content file => e.g. src/site/_data/courses/it-user-skills-level-2/01-word-processing-software/01-welcome/03.yaml
#}

{% set module = courses[folders.course][folders.unit][folders.session][moduleNum] %}

{%- set tilde = "~" if site.env == "dotnet" -%}

{%- set unitNameFilter = "0" + unit -%}
{%- set sessionNameFilter = "0" + session -%}

{%- set unitData = courses[course] | courseinfo %}
{%- set thisUnit = unitData.keysOrdered[unit - 1] %}
{%- set unitName = thisUnit | replace(unitNameFilter, "") | replace("-", " ") | trim | capitalize -%}
{%- set sessionData = courses[course][thisUnit] | courseinfo -%}
{%- set thisSession = sessionData.keysOrdered[session - 1] %}
{%- set sessionName = thisSession | replace(sessionNameFilter, "") | replace("-", " ") | trim | capitalize -%}
{%- set coursename = course -%}
{%- set unitCount = unitData.size %}
{%- set sessionCount = sessionData.size -%}

{# 
  IT1 & 2 have time to practice, not think 
  shortcode is found in coursename.11tydata.js
#}
{% if shortcode == 'it2' or shortcode == 'it1' %}
  {% set timeToWhat = 'Practice'%}
{% else %}
  {% set timeToWhat = 'Think'%}
{% endif %}

{%- if (session) < sessionCount %}
  {%- set nextSession = session + 1 %}
  {%- set nextUnit = unit %}
{%- else %}
  {%- set nextSession = 1 %}
  {%- set nextUnit = unit + 1 %}
{%- endif %}

{%- set lastPage = (pagination.pageNumber == pagination.hrefs.length - 1) %}

{%- import 'components/all.njk' as components %}

<!-- course -->
{# BANNER #}
{%- include 'components/banner.njk' %}
{# /BANNER #}

{%- if pagination.pageNumber == 0 and session == 1 %}
  {# IMPORT Page 1 layout #}
  <!-- session1_page1 -->
  {%- include 'page-chunks/session1_page1.njk' %}
  

{# *********** START ************** #}

{%- elseif pagination.pageNumber == 1 and session == 1 and unit == 1 %}
  {# IMPORT Unit 1 Session 1 Page 2 layout #}
  <!-- unit1_session1_page2 -->
  {%- include 'page-chunks/unit1_session1_page2.njk' %}
{%- else %}
  {# NORMAL PAGES #}
  <!-- sections.njk -->
  {%- include 'page-chunks/sections.njk' %}
  <!-- sections -->
  {%- if lastPage %}
  {%- include 'page-chunks/lastpage.njk' %}
    <!-- last -->
  {%- endif -%}
{%- endif %}

{# ************* FIN **************** #}
