{{ pagination.items[0].data.title }}
{{ pagination.items[0].url }}

<section>
  {{pagination.items[0].templateContent }}
</section>
{% comment %} permalink: unikitty/{{unikitty}}/index.html {% endcomment %}

{% comment %} <p>{{ unikitty }}...</p> {% endcomment %}
{% comment %} <p>PagObj: {{ pagination }}...</p> {% endcomment %}

{%- for item in collections.session-1  -%}
  <p>{{item.data.title}}</p>
  {% comment %} <p>{{item.fileSlug }} {{ item.data.tags }}{{ item.data.title }}, {{ item.url }}</p> {% endcomment %}
  <p>URL: {{ item.url }}</p>
  {% comment %} <p>{{item.fileSlug | slug }}</p> {% endcomment %}
{%- endfor -%}

{% comment %} 

{%- for item in collections.lean-management -%}
  <p>{{item.fileSlug }} {{ item.data.tags }}{{ item.data.title }}, {{ item.url }}</p>

{%- if forloop.index0 == 0 -%}
    <section>
      <h1>{{ item.data.title }}</h1>
      {{ item.templateContent }}
    </section>
  {%- endif -%} 
  
{%- endfor -%}

 {% endcomment %}
 </main>