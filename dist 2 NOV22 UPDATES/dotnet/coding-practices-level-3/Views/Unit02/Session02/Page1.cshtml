  <h2><svg viewBox="0 0 222.27 185" xmlns="http://www.w3.org/2000/svg" aria-hidden="true" focusable="false" ><path d="m78.25 151.21h65.78v28.81h-65.78z" fill="#b5c7ca"/><g fill="#dcf1fa"><path d="m148.09 179.51h-73.91c-1.87 0-3.4 1.79-3.4 4v1.49h80.71v-1.5a3.73 3.73 0 0 0 -3.4-3.99z"/><path d="m0 140v15.88a5.52 5.52 0 0 0 5.53 5.53h211.21a5.53 5.53 0 0 0 5.53-5.53v-15.88z"/><path d="m222.27 140v-134.46a5.54 5.54 0 0 0 -5.53-5.54h-211.21a5.53 5.53 0 0 0 -5.53 5.54v134.46z"/></g><path d="m9.11 8.65h204.06v122.17h-204.06z" fill="#00a6e0"/><path d="m214 131.61h-205.69v-123.76h205.69zm-204.1-1.61h202.47v-120.56h-202.47z" fill="#4a4f55"/></svg>
