        <section id="principles-of-confidentiality"  class="t-bg-primary">
          
            <h2>Principles of confidentiality</h2>
              <p>Select the images below to learn more about the principles.</p>

              
              <!-- IF 2 --><ul class="l-icon-grid ">
  
  
    
    <!--  -->
      
  
  
    
  
  <li class="c-reveal-block">
    <img class="c-reveal-block__icon js-showhide" src="~/images/svg/demo/ua_u2_s2_p4_reveal1.svg" alt="Kept confidential" width="266" height="266">
    
    <div class="c-reveal-block__desc">
      <h3 aria-hidden="true">Kept confidential</h3>
      <p>All confidential information must be kept confidential.</p>

    </div>
  </li>
      
  
  
    
  
  <li class="c-reveal-block">
    <img class="c-reveal-block__icon js-showhide" src="~/images/svg/demo/ua_u2_s2_p4_reveal2.svg" alt="Permission" width="266" height="266">
    
    <div class="c-reveal-block__desc">
      <h3 aria-hidden="true">Permission</h3>
      <p>Confidential Information will not be disclosed about an individual to anyone else without their permission.</p>

    </div>
  </li>
      
  
  
    
  
  <li class="c-reveal-block">
    <img class="c-reveal-block__icon js-showhide" src="~/images/svg/demo/ua_u2_s2_p4_reveal3.svg" alt="Legal duty" width="266" height="266">
    
    <div class="c-reveal-block__desc">
      <h3 aria-hidden="true">Legal duty</h3>
      <p>Confidential information is only shared when required by law and there is a legal duty to make a disclosure.</p>

    </div>
  </li>
      
  
  
    
  
  <li class="c-reveal-block">
    <img class="c-reveal-block__icon js-showhide" src="~/images/svg/demo/ua_u2_s2_p4_reveal4.svg" alt="Prevent serious harm" width="266" height="266">
    
    <div class="c-reveal-block__desc">
      <h3 aria-hidden="true">Prevent serious harm</h3>
      <p>Confidential information is only shared when it is necessary in order to prevent serious harm to the individual or someone else.</p>

    </div>
  </li>
      
  
  
    
  
  <li class="c-reveal-block">
    <img class="c-reveal-block__icon js-showhide" src="~/images/svg/demo/ua_u2_s2_p4_reveal5.svg" alt="Valid reason" width="266" height="266">
    
    <div class="c-reveal-block__desc">
      <h3 aria-hidden="true">Valid reason</h3>
      <p>There must be a valid reason for confidential information to be disclosed without permission</p>

    </div>
  </li>
  
</ul>

            
          
        </section>
        
    
     
    
  
     
    
  
  
